# ===============================
# ASP.NET Core Environment
# ===============================
ASPNETCORE_ENVIRONMENT=Development

# ===============================
# Azure Key Vault URL
# ===============================
KeyVaultUri=https://YOUR_KEYVAULT_NAME.vault.azure.net/

# ===============================
# SAML2 Configurations (Mocking Key Vault for Local Dev)
# ===============================
Saml2__SigningCertificate=/K1SLk...[MOCK_CERTIFICATE_HERE]...
Saml2__SigningCertificatePassword=YOUR_CERT_PASSWORD

# ===============================
# API Connection / Database Strings (Without Business Logic)
# ===============================
ConnectionApi__ClientSecret=YOUR_API_SECRET
ConnectionApi__Url=https://YOUR_API_URL.azurewebsites.net
